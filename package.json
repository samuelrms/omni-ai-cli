    "claude",
    "codex",
    "antigravity",
    "openrouter",
    "mcp",
    "router"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelrms/omni-ai-cli.git"
  },
  "homepage": "https://github.com/samuelrms/omni-ai-cli#readme",
