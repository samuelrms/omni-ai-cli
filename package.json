{
  "name": "omni-ai-cli",
  "version": "1.0.0",
  "description": "One chat for Claude Code, Codex, Antigravity and OpenRouter, with automatic routing, account fallback, API keys, permission modes and MCP/skill sync.",
  "bin": {
    "ai": "bin/ai.js",
    "omni-ai": "bin/ai.js",
    "smart-ai": "bin/ai.js"
  },
  "files": [
    "bin/",
    "smart_ai.py",
    "terminal.py",
    "config_tool.py",
    "sync_tool.py",
    "skills.py",
    "vendor/",
    "ui.py",
    "platform_utils.py",
    "openrouter_client.py",
    "pii_masker.py",
    "profiles.json",
    "README.md",
    "README.en.md",
    "README.es.md",
    "README.fr.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@anthropic-ai/claude-code": "*"
  },
  "engines": {
